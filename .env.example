# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/univoice

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_JOIN_TOKEN_EXPIRES_IN=24h

# --- Auth (개발 전용) ---
# true면 인증/역할 검사를 모두 건너뜀 (토큰 없이 호출 가능). 운영에서는 반드시 false.
AUTH_DISABLED=false

# --- LiveKit ---
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SEC=14400

# --- Azure Blob Storage ---
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=univoice-materials

# --- QR ---
QR_BASE_URL=https://app.univoice.example.com/join

# --- RAG (검색 서버 인덱싱 트리거) ---
# 자료 업로드 시 이 Redis List에 인덱싱 잡을 적재한다 (RAG 워커가 BRPOP으로 소비).
RAG_INDEX_QUEUE=rag:index:queue

# --- AI Worker shutdown coordination ---
WORKER_STOP_TIMEOUT_SEC=8
WORKER_STOP_POLL_INTERVAL_MS=200
