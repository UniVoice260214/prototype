# --- Redis (Core API와 동일 인스턴스) ---
REDIS_URL=redis://localhost:6379

# --- LiveKit (Core API와 동일 키) ---
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Azure Speech (STT + TTS 공용) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# --- STT ---
STT_LANGUAGE=ko-KR

# --- 번역 provider: "openai" 또는 "azure" ---
TRANSLATE_PROVIDER=openai

# openai 인 경우
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# azure(Azure OpenAI) 인 경우
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- TTS voice 매핑 덮어쓰기 (선택, JSON) ---
# 미설정 시 zh-CN/vi-VN/mn-MN/en-US/ja-JP 기본 Neural voice 사용
# TTS_VOICE_MAP={"zh-CN":"zh-CN-XiaoxiaoNeural","vi-VN":"vi-VN-HoaiMyNeural"}
