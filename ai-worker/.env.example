# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- LiveKit ---
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Azure Speech (shared STT + TTS resource) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# --- STT ---
# 프로바이더: azure(기본) | openai. Azure 는 그대로 두고 설정으로만 전환한다.
# openai 는 Realtime 전사(gpt-4o-transcribe) — OPENAI_API_KEY 가 필수가 된다.
STT_PROVIDER=azure
STT_OPENAI_MODEL=gpt-4o-transcribe
# server_vad 침묵 분할. OpenAI 전사는 턴 방식(발화가 끝나야 전사)이라
# Azure(800)보다 낮춰 절 단위로 빨리 확정되게 한다.
STT_OPENAI_SILENCE_MS=500
# logprobs 기반 유사 신뢰도 수집 (끄면 sttConfidence 계측이 비게 된다)
STT_OPENAI_LOGPROBS=true
# phrase list 를 prompt 힌트로 접을 때 상한
STT_OPENAI_KEYWORDS_MAX=100
# VAD 감도(0~1, 높을수록 둔감). 소음이 발화로 오인되면 모델이 prompt 의
# 전공 용어를 지어내(환청) 유령 자막·TTS 가 나간다.
STT_OPENAI_VAD_THRESHOLD=0.6
# 환청 가드: 이 유사 신뢰도 미만의 전사는 폐기 (0 이면 끔)
STT_OPENAI_MIN_CONFIDENCE=0.5
STT_LANGUAGE=ko-KR
STT_MAX_RECONNECTS=3
STT_RECONNECT_BASE_DELAY_MS=500

# --- STT 인식 튜닝 (한국어 강의 발화 기준. Azure 기본값이 아니다) ---
# Azure 기본 segmentation timeout(~500ms)은 어절/조사 뒤 휴지를 문장 끝으로 오인해
# 절 중간을 자른다. 800ms 면 절 내부 휴지는 삼키고 문장 경계는 그대로 잡는다.
STT_SEGMENTATION_SILENCE_MS=800
# 쉼 없이 이어지는 발화도 이 시간마다 강제 확정해 자막 지연을 막는다 (Azure 허용 20000~70000, 0=off)
STT_SEGMENTATION_MAX_TIME_MS=20000
# 수업 시작 직후 판서/자료 준비로 무음이 길어도 STT 가 취소되지 않게 한다.
STT_INITIAL_SILENCE_MS=15000
STT_END_SILENCE_MS=1000
# 문장부호·대소문자 후처리. 이게 있어야 segmenter 의 문장 분리가 실제로 동작한다.
STT_TRUE_TEXT=true
# 기본값 Masked 는 전공어가 비속어로 오분류될 때 '****' 로 자막을 망친다.
STT_PROFANITY_RAW=true
# Azure Custom Speech 엔드포인트 ID. 비워 두면 범용 ko-KR 모델을 쓴다.
STT_ENDPOINT_ID=
# PhraseList: 0.0~2.0 (기본 1.0). 항목 수 상한은 Azure 문서 기준 500.
STT_PHRASE_LIST_WEIGHT=1.0
STT_PHRASE_LIST_MAX_ITEMS=500
STT_PHRASE_LIST_MAX_CHARS=8000
# 이 값 미만이면 경고 로그만 남긴다 (자막을 버리지는 않는다).
STT_LOW_CONFIDENCE_WARN=0.5

# --- 번역 ---
# openai SDK 기본 타임아웃은 600초다. 컨슈머가 직렬이라 한 번 늘어지면 자막이 전부 멈춘다.
TRANSLATE_TIMEOUT_SEC=8.0

# --- RAG (전공 기본 RAG + 강의안 RAG) ---
# 인덱스를 빌드하고 rag-service 를 띄운 뒤에 true 로 켠다.
#   cd rag-experiment && python src/build_demo_indexes.py
#   uvicorn server:app --app-dir src --port 8000
RAG_ENABLED=false
RAG_URL=http://rag-service:8000
# auto 면 STT lexicon 교정이 비활성된다. 과목별 전공을 아래 맵에 지정하라.
RAG_DEFAULT_MAJOR=auto
# {"<courseId>": "ai" | "hss" | "bme"}
RAG_COURSE_MAJOR_MAP=
RAG_TIMEOUT_SEC=2.0
# lexicon_{ai,hss,bme}.json 이 있는 디렉터리 (STT 전공 용어 교정 자산)
RAG_ASSETS_DIR=rag_assets

# --- Worker lifecycle ---
WORKER_STATUS_TTL_SEC=3600
# 세션 종료 체인 타임아웃. 종료가 hang 하면 다음 수업 활성화까지 막히므로
# 어느 단계도 무제한 대기하지 않는다. 종료 시점의 TTS 백로그는 폐기된다
# (NestJS 가 8초 뒤 룸을 지우므로 그 이후 재생은 무가치).
SESSION_STOP_TIMEOUT_SEC=15
PIPELINE_FLUSH_TIMEOUT_SEC=5
TTS_FLUSH_TIMEOUT_SEC=3

# --- Translation provider: "openai" or "azure" ---
TRANSLATE_PROVIDER=azure

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Optional TTS voice map override (JSON) ---
# TTS_VOICE_MAP={"zh-CN":"zh-CN-XiaoxiaoNeural","vi-VN":"vi-VN-HoaiMyNeural"}
TTS_TIMEOUT_SEC=15
TTS_MAX_RETRIES=2
TTS_RETRY_BASE_DELAY_MS=500
TTS_MAX_CONCURRENCY=3
TTS_QUEUE_MAX_SIZE=100
TTS_DEDUPE_TTL_SEC=3600
TTS_FAILED_DEDUPE_TTL_SEC=30

# --- Segment pipeline ---
# 짧은 세그먼트가 자막 지연을 줄이고 번역 품질도 낫다.
SEGMENT_MAX_CHARS=60
SEGMENT_IDLE_FLUSH_MS=1200
SEGMENT_MIN_CHARS=2
# 구두점 없는 발화를 한국어 종결어미(~습니다 등)에서 끊는다 (기본 on)
SEGMENT_SPLIT_KOREAN_ENDINGS=true
SEGMENT_QUEUE_MAX_SIZE=100
SEGMENT_ENQUEUE_TIMEOUT_MS=250

# --- 지연 계측 (기본 off) ---
# 경로를 지정하면 세그먼트별 구간 지연이 JSONL 로 쌓인다. 집계는
# `python tools/latency_report.py --input <경로>`. 자세한 절차는
# docs/latency-measurement.md 참조. 상시 켜둘 필요는 없다.
# LATENCY_LOG_PATH=latency.jsonl
