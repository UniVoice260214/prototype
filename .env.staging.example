# Public HTTPS host. Create a DNS A/AAAA record to the staging VM first.
STAGING_DOMAIN=staging.univoice.example.com
ACME_EMAIL=ops@univoice.example.com

# Use URL-safe random values (letters, numbers, _ and -).
POSTGRES_PASSWORD=replace_with_32_char_url_safe_value
REDIS_PASSWORD=replace_with_32_char_url_safe_value
JWT_SECRET=replace_with_at_least_32_random_characters

# Idempotent initial administrator seed.
SEED_ADMIN_EMAIL=admin@univoice.example.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_ADMIN_NAME=Staging Admin

# LiveKit Cloud or a separately hosted LiveKit server.
LIVEKIT_URL=wss://replace-with-livekit-host
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
LIVEKIT_TOKEN_TTL_SEC=14400

# Azure Speech provides both STT and TTS.
AZURE_SPEECH_KEY=replace_with_azure_speech_key
AZURE_SPEECH_REGION=koreacentral
STT_LANGUAGE=ko-KR

# Translation provider: openai or azure.
TRANSLATE_PROVIDER=openai
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Lecture material storage.
AZURE_BLOB_CONNECTION_STRING=replace_with_azure_blob_connection_string
AZURE_BLOB_CONTAINER=univoice-materials

# Staging behavior.
SWAGGER_ENABLED=true
JWT_EXPIRES_IN=1d
JWT_JOIN_TOKEN_EXPIRES_IN=24h
WORKER_STOP_TIMEOUT_SEC=8
WORKER_STOP_POLL_INTERVAL_MS=200
