# Public HTTPS host. Create a DNS A/AAAA record to the staging VM first.
STAGING_DOMAIN=staging.univoice.example.com
ACME_EMAIL=ops@univoice.example.com

# Use URL-safe random values (letters, numbers, _ and -).
POSTGRES_PASSWORD=replace_with_32_char_url_safe_value
REDIS_PASSWORD=replace_with_32_char_url_safe_value
JWT_SECRET=replace_with_at_least_32_random_characters

# Idempotent initial administrator seed.
SEED_ADMIN_EMAIL=admin@univoice.example.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_ADMIN_NAME=Staging Admin

# LiveKit Cloud or a separately hosted LiveKit server.
LIVEKIT_URL=wss://replace-with-livekit-host
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
LIVEKIT_TOKEN_TTL_SEC=14400

# Azure Speech provides both STT and TTS.
AZURE_SPEECH_KEY=replace_with_azure_speech_key
AZURE_SPEECH_REGION=koreacentral
STT_LANGUAGE=ko-KR

# Translation provider: openai or azure.
TRANSLATE_PROVIDER=openai
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Lecture material storage.
AZURE_BLOB_CONNECTION_STRING=replace_with_azure_blob_connection_string
AZURE_BLOB_CONTAINER=univoice-materials
# Anonymous read of uploaded materials. rag-indexer-daemon downloads uploads by
# URL, so indexing of uploaded materials needs this. Anyone with a URL can then
# download the file without logging in; replace with SAS before production.
AZURE_BLOB_PUBLIC_ACCESS=false
# Required (https) when AZURE_BLOB_PUBLIC_ACCESS=true.
# e.g. https://<account>.blob.core.windows.net/univoice-materials
AZURE_BLOB_PUBLIC_BASE_URL=

# RAG (major term context). Search waits at most RAG_TIMEOUT_SEC per segment.
RAG_ENABLED=true
RAG_DEFAULT_MAJOR=auto
RAG_TIMEOUT_SEC=0.4

# Latency tuning (ai-worker/README.md, docs/latency-results-2026-09-26.md).
# Values below are the defaults; the 2026-09-26 tuned run used
# SEGMENT_MAX_CHARS=80, STT_SEGMENTATION_SILENCE_MS=600,
# SEGMENT_SPLIT_KOREAN_CLAUSES=true, CAPTION_DRAFT_ENABLED=true, TTS_SPEAKING_RATE=1.2.
SEGMENT_MAX_CHARS=120
SEGMENT_IDLE_FLUSH_MS=2000
STT_SEGMENTATION_SILENCE_MS=800
SEGMENT_SPLIT_KOREAN_CLAUSES=false
CAPTION_DRAFT_ENABLED=false
CAPTION_DRAFT_INTERVAL_MS=1000
TTS_MAX_QUEUE_WAIT_MS=3000
TTS_SPEAKING_RATE=1.0
# Per-segment latency JSONL inside the worker container; empty disables it.
LATENCY_LOG_PATH=

# Staging behavior.
SWAGGER_ENABLED=true
JWT_EXPIRES_IN=1d
JWT_JOIN_TOKEN_EXPIRES_IN=24h
WORKER_STOP_TIMEOUT_SEC=8
WORKER_STOP_POLL_INTERVAL_MS=200
