# Tailscale device DNS name without a scheme or trailing dot.
# Find it with: tailscale status --json
TAILSCALE_HOSTNAME=replace-with-device-name.tailnet-name.ts.net

# Local Docker services. Use different URL-safe random values.
POSTGRES_PASSWORD=replace_with_32_char_url_safe_value
REDIS_PASSWORD=replace_with_32_char_url_safe_value
JWT_SECRET=replace_with_at_least_32_random_characters

# Idempotent initial administrator seed.
SEED_ADMIN_EMAIL=admin@univoice.local
SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_ADMIN_NAME=Demo Admin

# Existing LiveKit Cloud project.
LIVEKIT_URL=wss://replace-with-livekit-host
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
LIVEKIT_TOKEN_TTL_SEC=14400

# Existing Azure Speech resource.
AZURE_SPEECH_KEY=replace_with_azure_speech_key
AZURE_SPEECH_REGION=koreacentral
STT_LANGUAGE=ko-KR

# Choose exactly one translation provider: openai or azure.
TRANSLATE_PROVIDER=openai
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Required only when TRANSLATE_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Local Azurite container name. No Azure Storage account is used.
AZURE_BLOB_CONTAINER=univoice-materials

# Demo behavior.
SWAGGER_ENABLED=true
JWT_EXPIRES_IN=1d
JWT_JOIN_TOKEN_EXPIRES_IN=24h
WORKER_STOP_TIMEOUT_SEC=8
WORKER_STOP_POLL_INTERVAL_MS=200
# Demo RAG. A course's own major (POST /courses { "major": "ai" }) takes precedence;
# the settings below only apply to courses without one. auto compares all three
# major routers; use ai, hss, or bme to pin one.
RAG_ENABLED=true
RAG_MAX_SEQ_LENGTH=512
RAG_DEFAULT_MAJOR=auto
RAG_COURSE_MAJOR_MAP=
# Course-scoped index isolation. Courses not listed here search their major's
# textbook/glossary index only (no lecture slides mixed in). See docs/rag-demo.md.
RAG_COURSE_INDEX_MAP=
RAG_TOP_K=3
RAG_CONTEXT_MAX_CHARS=4000
# RAG sits synchronously on the translation critical path; kept short with
# fail-open so a slow/unavailable RAG service never stalls subtitles/TTS.
RAG_TIMEOUT_SEC=0.4
# Bounded concurrency for embedding+FAISS calls (avoids CPU thread
# oversubscription while letting multiple sessions' searches overlap) and a
# short-TTL cache for repeated terms within a lecture. See docs/rag-demo.md.
RAG_SEARCH_CONCURRENCY=2
RAG_SEARCH_CACHE_SIZE=256
RAG_SEARCH_CACHE_TTL_SEC=300
